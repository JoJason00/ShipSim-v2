      // 文献对照船模 3.5 m；仿真 Lpp=Ship.Geometry.Length，CSV 中 u_mdl 等按 k=sqrt(3.5/L_sim) 写入
      "referenceModelLppM": 3.5
    },
    "physics": {
      "enableFastSeakeeping": true,
      "enableSecondOrderLoads": true,
      //"waveForceMode": "directFK",
      //"waveForceMode": "fkImpulse",
      "waveForceMode": "directFKdf",
      "enableRadiation": true
    }
  }
