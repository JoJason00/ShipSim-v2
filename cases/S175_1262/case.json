      //   总横摇 = 这里的慢横倾(phi_roll) + 耐波快解算器的波浪横摇，做线性叠加。
      //   下列比值(zH/d, zR/d, zG/d, N 系数)是无量纲的，直接适用于 3.0337m 船模；
      //   尺寸量(Ixx, GM, m, d)用本船自身值(取自 Ship.Mass)。
      //   rollJxxAdd≈耐波 A∞(roll)=0.326，使慢/快横摇固有周期一致(≈1.6s)。
      //   rollB44_lin/quad 沿用耐波标定值(1.0/8.0)。
      //   zG_over_d=0(重心在水线)→无舵致内倾、无惯性耦合，仅离心外倾；要内倾把它设非零。
      "maneuverDOF": 4,
      "rollJxxAdd": 0.326,
      "rollB44_lin": 1.5,
      "rollB44_quad": 12.0,
      "zH_over_d": 0.5,
