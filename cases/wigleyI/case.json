    "Fn": [ 0.3 ],
    "DOF": 3,
    "modes": [ 2, 3, 4 ],

    "PanelSettings": {
      "NEType": "halfship",
      "NE": 210
    },

    "TimeSettings": {
      "dt": 0.05,
      "TimeCircle": 20,
      "PreCircle": 2.5,
      "GreenCircle": 2.5
    },

    "Solver": {
      "Method": "Potential",
      "ResponseMethod": "LinearCumminsTDGF",
      "FKForceMethod": "TDGFImpulse"
      //"FKForceMethod": "DirectPressure"
    },

    "GreenFunction": {
      "Method": "Exact",
      "TablePath": "tdgf_ode_table.bin",
      "RK4Step": 0.001
    },

    // Lu et al. 2024: following — long Beck memory; test τ_nd window via MemoryCapNd* (≈ half-width).
    // Head (180°): MemoryCapNdHead ≈ 6 → τ_nd roughly in [−6, +6].
    // MaxFKImpulseRows: auto-coarsen dt when the impulse table gets too long (following seas).
    "FKImpulseKernel": {
      "Method": "Auto",
      "IncludeShipName": true,

      "RegionAdaptiveKernelGrid": true,

      "SamplesPerWavePeriod": 20.0,
      "DtFloorNd": 0.005,
      "DtCapNd": 0.10,
      "MemoryEncounterPeriods": 8.0,
      "MemoryFloorNd": 5.0,
      "MemoryCapNd": 30.0,

      "SamplesPerWavePeriodHead": 40.0,
      "DtCapNdHead": 0.05,
      "MemoryEncounterPeriodsHead": 3.5,
      "MemoryFloorNdHead": 2.0,
      "MemoryCapNdHead": 6.0,

      "SamplesPerWavePeriodFollowing": 30.0,
      "DtCapNdFollowing": 0.10,
      "MemoryEncounterPeriodsFollowing": 12.5,
      "MemoryFloorNdFollowing": 6.0,
      "MemoryCapNdFollowing": 80.0,

      "MemoryEncounterPeriodsF2": 15.0,
      "MemoryCapNdF2": 80.0,
      "FollowingMemoryMinIncidentPeriods": 3.5,

      "MaxFKImpulseRows": 2200,

      "TailTolRel": 1.0e-3
    },

    // ===========================================================
    // 非均匀 chi 时间网格 — 离线 K(t) build 用，不影响在线运动方程
    // ===========================================================
    //
    // dt_fine 必须与 dtShared_ 一致：
    //   dtShared_ = 0.015 / sqrt(g/L) = 0.015 / sqrt(9.81/30) ≈ 0.02623
    // 写 0.026231249... 不如直接用同样的表达式产物。这里写 0.0262312。
    //
    // 当前是【测试 A：退化等距】配置 —— stride=1, count=800，
    // chi 节点数 801，与老等距路径完全一致；RAO 结果应该与之前几乎相同。
    //
    // 验证通过后切到【测试 B】（在下面注释里），享受非均匀加速。
    //"ChiTimeGrid": {
    //  "enabled": true,
    //  "dt_fine": 0.0262312,
    //  "blocks": [
    //    { "stride": 1, "count": 800 }
    //  ],
    //  "memory_cutoff_lag": 0
    //},

    // ----- 测试 B 用这个（注释切换即可）：稀疏网格 + 截断 -----
    // 节点分布：0~ 2.6s 用 dt_fine，2.6~ 13.1s 用 4·dt_fine，13.1~ 21s 用 20·dt_fine
    //   blocks 总 fine 步数 = 100 + 4*125 + 20*30 = 1200
    //   tMax = 1200 * 0.0262 ≈ 31.5s
    //   chi 节点数 = 1 + 100 + 125 + 30 = 256（原 801，约 3× 减少）
    //   memory_cutoff_lag = 200 ≈ 5.2s（按 chi 卷积近端记忆截断）
    //
    // 当前【推荐】配置：长尾延长版（tMax ≈ 64s）
    //   - 前半 (0~32s) 与 4-阶差分误差需求一致：stride ≤ 4，h⁴ ≤ 10⁻⁴
    //   - 后半 (32~64s) K(t) ≈ 0，stride 6/10 即可，仅占少量节点
    //   - 共 691 chi 节点（uniform 800 的 86%），stride 阶梯全部 ≤ 2×

